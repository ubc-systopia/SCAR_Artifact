+/**
+ * Return either `a` or `b` based on `cond`, in algorithmic constant time.
+ * It requires passing a `bitLength` value large enough to represent `a` and `b`.
+ * @param {Boolean} cond
+ * @param {BigInt} a
+ * @param {BigInt} b
+ * @param {BigInt} maxBitLength
+ * @returns `a` if `cond` is true, `b` otherwise
+ */
+function selectBigInt(cond: bigint, a: bigint, b: bigint, maxBitLength: bigint) {
+  const mask = _1n << maxBitLength;
+  return (a & (mask - cond)) | (b & (mask - _1n + cond));
+}
